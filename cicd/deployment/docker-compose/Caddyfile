{$CADDY_DOMAIN_NAME}:{$CADDY_HTTPS_PORT} {
    # FastAPI
    handle_path {$CADDY_BACKEND_ROOT_API}/* {
        reverse_proxy api:{$FASTAPI_PORT} {

            # Pass the real IP, drop client supplied values
            header_up  -X-Forwarded-For                # Strip incoming header
			header_up  X-Forwarded-For  {remote_host}  # Add the true client IP
			header_up  X-Real-IP       {remote_host}   # For some libs (optional)
			header_up  X-Forwarded-Proto {scheme}      # Let app know it's HTTPS

            transport http {
                dial_timeout 100s
                read_timeout 100s
                write_timeout 100s
            }
        }
    }

    # FastMCP
    handle_path {$CADDY_BACKEND_ROOT_MCP}/* {
        reverse_proxy mcp:{$FASTMCP_PORT} {

            # Same header hygiene
            header_up  -X-Forwarded-For
			header_up  X-Forwarded-For  {remote_host}
			header_up  X-Real-IP       {remote_host}
			header_up  X-Forwarded-Proto {scheme}

            transport http {
                dial_timeout 100s
                read_timeout 100s
                write_timeout 100s
            }
        }
    }
}
