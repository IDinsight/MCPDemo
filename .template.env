# Template for the global .env file.
# Rename this file to .env and fill in the required values.

# AUTH #
# Notes
#
# 1. Run 'openssl rand -base64 48' in terminal to generate a value for AUTH_RSA_PASSPHRASE.
AUTH_AUDIENCE=MCP_Demo_Server
AUTH_JWKS_FN=jwks.json
AUTH_ROTATION_KEEP_LAST_N=2
AUTH_RSA_PASSPHRASE=
AUTH_TOKEN_REFRESH_TTL=2592000
AUTH_TOKEN_TTL=900

# CADDY #
# Notes
#
# 1. Set CADDY_DOMAIN_NAME to "localhost"/"dev.localhost"/"prod.localhost" for local/dev/prod environments.
CADDY_DOMAIN_NAME=localhost

# CROSS-SITE REQUEST FORGERY #
# Notes
#
# 1. Run `openssl rand -base64 32` in terminal to generate a value for CSRF_SECRET_KEY.
CSRF_SECRET_KEY=

# DOCKER #
DOCKER_CADDY_IMAGE=caddy:2.7.6
DOCKER_PG_VECTOR_IMAGE=pgvector/pgvector:pg16
DOCKER_REDIS_IMAGE=redis:6.0-alpine

# EXTERNAL FASTMCP #
EXTERNAL_FASTMCP_HOST=0.0.0.0
EXTERNAL_FASTMCP_MOUNT_PATH=external
EXTERNAL_FASTMCP_PORT=8200
EXTERNAL_FASTMCP_TRANSPORT=http

# FASTAPI #
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# FASTMCP #
FASTMCP_HOST=0.0.0.0
FASTMCP_MOUNT_PATH=mcp
FASTMCP_PORT=8100
FASTMCP_TRANSPORT=http

# PATHS #
# 1. Do NOT include trailing slashes in the paths.
PATHS_PROJECT_DIR=~/MCPDemo
PATHS_SECRETS_DIR=~/MCPDemo/secrets

# POSTGRES #
POSTGRES_ASYNC_API=asyncpg
POSTGRES_DB=mcp_demo
POSTGRES_DB_POOL_SIZE=10
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_SYNC_API=psycopg2
POSTGRES_USER=postgres

# REDIS #
REDIS_URL=redis://localhost:6379
